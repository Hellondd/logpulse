# Скопируйте в .env (он в .gitignore) и при необходимости поправьте.
# Файл читает только docker compose; при запуске БЕЗ Docker эти переменные не нужны
# (по умолчанию приложение ходит в redis://localhost:6379/0).

# Внутри контейнеров Redis доступен по DNS-имени сервиса "redis", а не localhost
REDIS_URL=redis://redis:6379/0

# Порт API на хостовой машине (публикуется только на 127.0.0.1)
API_PORT=8000

# Worker: стабильное имя консьюмера, размер пачки и время блокировки XREADGROUP (мс)
WORKER_NAME=worker-1
WORKER_BATCH=100
WORKER_BLOCK_MS=2000

<mxfile host="app.diagrams.net"><diagram name="LogPulse: архитектура" id="logpulse-arch"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="compose" value="Docker Compose · проект logpulse · сеть logpulse_default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#7a8ba3;fontSize=12;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="30" width="1290" height="960" as="geometry"/></mxCell><mxCell id="redisbox" value="redis (контейнер) · redis:7-alpine&lt;br&gt;порт наружу НЕ публикуется · healthcheck: redis-cli ping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3f2;strokeColor=#b85450;fontSize=12;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="70" width="780" height="640" as="geometry"/></mxCell><mxCell id="statsbox" value="Статистика в Redis (пишет worker, читает api)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=12;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="440" height="520" as="geometry"/></mxCell><mxCell id="client" value="Клиент&lt;br&gt;браузер (/docs),&lt;br&gt;curl, PowerShell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="215" width="150" height="110" as="geometry"/></mxCell><mxCell id="envapi" value="Переменные окружения (.env / compose)&lt;br&gt;REDIS_URL=redis://redis:6379/0&lt;br&gt;API_PORT=8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="240" y="70" width="360" height="90" as="geometry"/></mxCell><mxCell id="api" value="api (контейнер)&lt;br&gt;uvicorn + FastAPI · APIRouter · Pydantic&lt;br&gt;Depends(get_db) · /health /ingest /stats /events&lt;br&gt;порт 127.0.0.1:8000 → 8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="190" width="360" height="140" as="geometry"/></mxCell><mxCell id="worker" value="worker (контейнер)&lt;br&gt;python -m app.worker&lt;br&gt;XREADGROUP → обработка → XACK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="640" width="360" height="120" as="geometry"/></mxCell><mxCell id="envwrk" value="Переменные окружения (.env / compose)&lt;br&gt;REDIS_URL=redis://redis:6379/0&lt;br&gt;WORKER_NAME=worker-1&lt;br&gt;WORKER_BATCH=100 · WORKER_BLOCK_MS=2000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="240" y="800" width="360" height="130" as="geometry"/></mxCell><mxCell id="stream" value="logpulse:events&lt;br&gt;Stream (очередь)&lt;br&gt;группа logpulse-workers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="210" height="90" as="geometry"/></mxCell><mxCell id="cnt" value="logpulse:stats:accepted / :processed&lt;br&gt;String · INCRBY / INCR&lt;br&gt;(принято в очередь / обработано)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="170" width="400" height="90" as="geometry"/></mxCell><mxCell id="hl" value="logpulse:stats:level&lt;br&gt;Hash · HINCRBY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="290" width="195" height="60" as="geometry"/></mxCell><mxCell id="hs" value="logpulse:stats:service&lt;br&gt;Hash · HINCRBY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="290" width="190" height="60" as="geometry"/></mxCell><mxCell id="ht" value="logpulse:stats:status&lt;br&gt;Hash · HINCRBY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="390" width="195" height="70" as="geometry"/></mxCell><mxCell id="procset" value="logpulse:processed&lt;br&gt;Set rid · SADD&lt;br&gt;(идемпотентность)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="390" width="190" height="70" as="geometry"/></mxCell><mxCell id="slow" value="logpulse:slow · Sorted Set&lt;br&gt;ZADD: score = duration_ms (≥ 500), member = rid&lt;br&gt;ТОП-5: ZREVRANGE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="490" width="400" height="80" as="geometry"/></mxCell><mxCell id="vol" value="именованный volume redis-data → /data&lt;br&gt;AOF (--appendonly yes): данные переживают restart контейнера" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e0f5;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="740" width="640" height="80" as="geometry"/></mxCell><mxCell id="recov" value="Восстановление после docker compose restart redis&lt;br&gt;1) Redis стартует и поднимает данные из AOF в томе redis-data&lt;br&gt;2) healthcheck redis-cli ping → healthy; api: /health 503 → 200 (клиент переподключается сам)&lt;br&gt;3) worker: ConnectionError → пауза 1, 2, 4 … 10 с → ensure_group + дообработка pending (XREADGROUP id=0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="850" width="740" height="120" as="geometry"/></mxCell><mxCell id="e1" value="HTTP" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="api"><mxGeometry x="0.00" relative="1" as="geometry"/></mxCell><mxCell id="e2" value="XADD + INCRBY accepted" style="endArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="stream"><mxGeometry x="0.00" relative="1" as="geometry"/></mxCell><mxCell id="e3" value="XREADGROUP ⇄ XACK" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;startArrow=classic;" edge="1" parent="1" source="stream" target="worker"><mxGeometry x="0.00" relative="1" as="geometry"/></mxCell><mxCell id="e4" value="MULTI/EXEC: SADD, HINCRBY ×3,&lt;br&gt;INCR processed, ZADD slow" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="statsbox"><mxGeometry x="0.24" relative="1" as="geometry"/></mxCell><mxCell id="e5" value="HGETALL · GET · ZREVRANGE&lt;br&gt;(отдельное чтение для /stats)" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="statsbox"><mxGeometry x="0.00" relative="1" as="geometry"/></mxCell><mxCell id="e6" value="AOF" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="redisbox" target="vol"><mxGeometry x="0.00" relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=classic;html=1;strokeColor=#999999;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="envapi" target="api"><mxGeometry x="0.00" relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="endArrow=classic;html=1;strokeColor=#999999;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="envwrk" target="worker"><mxGeometry x="0.00" 